# ============================================
# Hackintosh .gitignore
# MADE BY © 2026 aerhazu (GitHub)
# ============================================

# ====================
# macOS System Files
# ====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.TemporaryItems
.fseventsd
.VolumeIcon.icns
.AppleDouble
.LSOverride
ehthumbs.db
Thumbs.db

# ====================
# Personal SMBIOS Data (KEEP PRIVATE!)
# Please never commit your real serial numbers / UUIDs
# ====================
*serial*.txt
*uuid*.txt
SMBIOS-*.plist
config-personal.plist
my-smbios.plist
serials.txt
smbios.txt
nvram.plist
config-backup.plist

# ====================
# Backup Files
# ====================
*.backup
*.bak
*.old
*.orig
config.plist.backup
config.plist.bak

# ====================
# Log Files
# ====================
*.log
*.txt
debug.log
boot.log
opencore-*.txt
oc-*.log
logs/
debug/

# ====================
# OpenCore Debug Files
# ====================
DEBUG/
LOGS/
.opencore_debug
SysReport/
EFI/OC/Logs/
EFI/OC/SysReport/

# ====================
# Temporary / Cache Files
# ====================
*.tmp
*.temp
.cache/
temp/
Tools/tmp/
Tools/cache/

# ====================
# IDE / Editor Files
# ====================
.vscode/
.idea/
*.swp
*.swo
*~

# ====================
# Build Artifacts (Xcode / Kext Dev)
# ====================
*.o
*.dSYM/
build/
DerivedData/
__pycache__/
*.pyc

# ====================
# Node (if documentation site)
# ====================
node_modules/

# ====================
# Compressed Files (Optional)
# ====================
*.zip
*.rar
*.7z
*.tar.gz

# ====================
# Personal Notes / Docs (Optional)
# ====================
notes.md
personal-*.md
TODO.txt

# ====================
# EFI Backup Folders (Optional)
# ====================
EFI-Backup*/
EFI-Old*/
OLD-EFI/
EFIs/Sequoia/INSTALL/
EFIs/Sequoia/RELEASE

# ====================
# Keep These Files:
# ====================
# !EFI/
# !Screenshots/
# !README.md
# !LICENSE
# !config.plist (placeholder SMBIOS)
